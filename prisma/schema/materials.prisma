model ranks {
  id                String              @id @default(uuid())
  name_ar           String              @unique @default("")
  name_en           String?
  slug              String              @unique
  color             String?
  icon              String? 
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  students          student[]
  courses           courses[]
  userRankHistories user_rank_history[]
  stages            stage[]

  @@index([name_ar])
}

model stage {
  id String @id @default(uuid())

  name_ar String
  name_en String?

  slug          String         @unique
  rankId        String
  rank          ranks          @relation(fields: [rankId], references: [id], onDelete: Cascade)
  offlineGroups offlineGroup[]
  students      student[]
  courses       courses[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rankId])
}

model category {
  id        String   @id @default(uuid())
  name_ar   String   @default("")
  name_en   String?
  color     String   @default("#6366f1")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses courses[]
}

model courses {
  id               String                    @id @default(uuid())
  title_ar         String                    @unique @default("")
  title_en         String?
  description_ar   String?
  description_en   String?
  keywords         String[]                  @default([])
  rankId           String
  stageId          String?
  categoryId       String?
  price            Float?
  image            String                    @default("default_course.jpg")
  rank             ranks                     @relation(fields: [rankId], references: [id], onDelete: Cascade)
  stage            stage?                    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  category         category?                 @relation(fields: [categoryId], references: [id])
  lectures         lectures[]
  sections         sections[]
  offlineGroup     offlineGroupCourses[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  schedules        schedule[]
  purchaseRequests course_purchase_request[]
  purchases        CoursePurchase[]

  @@index([rankId])
  @@index([categoryId])
  @@index([title_ar])
}

model course_purchase_request {
  id          String   @id @default(uuid())
  studentId   String?
  name        String?
  phone       String?
  email       String?
  courseId    String
  status      String   @default("pending")
  receipt_img String?
  parentPhone String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
}

model CoursePurchase {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  purchasedAt DateTime @default(now())

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model lectures {
  id         String    @id @default(uuid())
  title_ar   String    @default("")
  title_en   String?
  content_ar String?
  content_en String?
  video_path   String?
  pdf_path     String?
  slides_path  String?
  date       DateTime?
  order      Int
  courseId   String
  course     courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  duration   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userLectures user_lectures[]
  schedules    schedule[]


  @@unique([courseId, order])
  @@index([courseId])
}

model user_lectures {
  id           String    @id @default(uuid())
  userId       String
  lectureId    String
  status       String    @default("completed")
  progress     Float     @default(0)
  lastPosition Float     @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture lectures @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId])
  @@index([lectureId])
}

model offlineGroup {
  id        String                @id @default(uuid())
  stageId   String                @unique
  stage     stage                 @relation(fields: [stageId], references: [id], onDelete: Cascade)
  qrToken   String                @unique
  qrActive  Boolean               @default(true)
  courses   offlineGroupCourses[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  students student[]
}

/// offlineGroupLectures

model offlineGroupCourses {
  id        String       @id @default(uuid())
  groupId   String
  courseId  String
  group     offlineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course    courses      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([groupId, courseId])
  @@index([groupId])
  @@index([courseId])
}
