model schedule {
  id                  String                 @id @default(uuid())
  teacherId           String
  studentId           String?
  courseId            String
  status              String                 @default("scheduled")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  notes               String?
  pdf_path            String?
  description         String?
  video_path          String?
  slides_path         String?
  link                String
  title               String
  platform            String?                @default("zoom")
  type                String                 @default("half")
  language            String                 @default("en")
  end_time            DateTime
  start_time          DateTime
  day_of_week         String?
  is_recurring        Boolean                @default(false)
  isGroup             Boolean                @default(false)
  maxStudents         String                 @default("1")
  parent_recurring_id String?
  rescheduledFromId   String?                @unique
  rescheduledToId     String?                @unique
  reviews             Review[]
  scheduleLogs        ScheduleLog?
  rescheduledTo       schedule?              @relation("RescheduleHistory", fields: [rescheduledToId], references: [id])
  rescheduledFrom     schedule?              @relation("RescheduleHistory")
  student             student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course              courses                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher             teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  requests            request[]
  lectures            lectures?              @relation(fields: [lecturesId], references: [id])
  lecturesId          String?
  order               Int?                   @default(0)
  groupStudents       GroupScheduleStudent[]
  subjectId           String?
  subject             subject?               @relation(fields: [subjectId], references: [id])

  @@index([teacherId])
  @@index([studentId])
  @@index([start_time])
  @@index([end_time])
  @@index([subjectId])
}

model GroupScheduleStudent {
  id         String   @id @default(uuid())
  scheduleId String
  studentId  String
  createdAt  DateTime @default(now())
  schedule   schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
  @@index([scheduleId])
  @@index([studentId])
}

model request {
  id            String    @id @default(uuid())
  sessionId     String?
  requesterId   String
  requesterRole String
  type          String
  priority      String    @default("medium") // low, medium, high
  title         String?
  status        String    @default("pending")
  reason        String?
  requestedData Json?
  adminId       String?
  adminNotes    String?
  attachments   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requester     user      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  schedule      schedule? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_request")
}

model ScheduleLog {
  id                 String    @id @default(uuid())
  scheduleId         String    @unique
  joinTime_student   DateTime?
  leaveTime_student  DateTime?
  joinTime_teacher   DateTime?
  leaveTime_teacher  DateTime?
  duration_student   Float?
  duration_teacher   Float?
  isTeacherLate      Boolean   @default(false)
  isTeacherCompleted Boolean   @default(false)
  isStudentAttended  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  schedule           schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  scheduleId String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  role       String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  reviewee   user     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   user     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  schedule   schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, reviewerId])
}
