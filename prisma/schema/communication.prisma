model Conversation {
  id        String    @id @default(uuid())
  teacherId String
  studentId String
  teacher   teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages  Message[]

  userTeacher   user?   @relation("TeacherConversations", fields: [teacherUserId], references: [id])
  userStudent   user?   @relation("StudentConversations", fields: [studentUserId], references: [id])
  teacherUserId String?
  studentUserId String?

  @@unique([teacherId, studentId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         user         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model support {
  id             String           @id @default(uuid())
  title_ar       String           @default("")
  title_en       String?
  url            String
  description_ar String           @default("")
  description_en String?
  category       support_category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  readingCount   Int              @default(0)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([active])
}

model support_category {
  id        String    @id @default(uuid())
  title_ar  String    @default("")
  title_en  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  supports  support[]

  @@index([active])
}

model notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
}
