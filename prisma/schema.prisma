generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                   String                  @id @default(uuid())
  email                String?                 @unique
  username             String?                 @unique
  password             String?
  name                 String?
  phone                String?
  createdAt            DateTime                @default(now())
  gender               String?
  age                  Int?
  updatedAt            DateTime                @updatedAt
  confirmAt            DateTime?
  roleId               String?
  code_country         String?
  status               String                  @default("pending")
  googleId             String?                 @unique
  provider             String                  @default("local")
  timezone             String                  @default("Africa/Cairo")
  image                Json?
  reviewsReceived      Review[]                @relation("ReviewsReceived")
  reviewsGiven         Review[]                @relation("ReviewsGiven")
  subscriptions        Subscription[]
  wallet               Wallet[]
  withdrawalRequests   WithdrawalRequest[]
  sessionRequests      request[]
  student              student?
  stuff                stuff?
  subscriptionRequests subscription_requests[]
  teacher              teacher?
  role                 role?                   @relation(fields: [roleId], references: [id])
  messages             Message[]
  conversations        Conversation[]          @relation("TeacherConversations")
  conversationsStudent Conversation[]          @relation("StudentConversations")
  userLectures         user_lectures[]
  posts                post[]
  attendancesCheckedIn Attendance[]            @relation("AttendanceCheckedInBy")

  @@index([email])
  @@index([username])
  @@index([googleId])
}

model role {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions rolePermission[]
  stuff           stuff[]
  teachers        teacher[]
  users           user[]
}

model permission {
  id              String           @id @default(uuid())
  name            String           @unique
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions rolePermission[]

  @@index([name])
  @@index([code])
}

model rolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model currency {
  id                 String              @id @default(uuid())
  name_en            String
  name_ar            String
  symbol             String
  code               String              @unique
  default            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  exchangeRate       Float
  plan               plan[]
  subscriptions      Subscription[]
  wallets            Wallet[]
  expenses           expenses[]
  teachers           teacher[]
  withdrawalRequests WithdrawalRequest[]

  @@index([name_en])
  @@index([name_ar])
  @@index([code])
}

model plan {
  id                   String                  @id @default(uuid())
  name                 String                  @unique
  description          String?
  price                String
  duration             Int
  features             Json?
  sessionsCount        Int                     @default(0)
  rescheduleCount      Int                     @default(0)
  type                 String                  @default("quarterly") // annual or monthly
  isGroup              Boolean                 @default(false)
  maxStudents          String                  @default("1")
  planType             String                  @default("individual")
  currencyId           String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  active               Boolean                 @default(false)
  currency             currency                @relation(fields: [currencyId], references: [id])
  subscriptions        Subscription[]
  students             student[]
  subscriptionRequests subscription_requests[]

  @@index([name])
}

model subscription_requests {
  id              String  @id @default(uuid())
  planId          String?
  status          String  @default("pending")
  subscrption_img String?   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user_id   String
  plan      plan?    @relation(fields: [planId], references: [id])
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([planId])
}

model stuff {
  id        String   @id @default(uuid())
  user_id   String   @unique
  roleId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      role?    @relation(fields: [roleId], references: [id])
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model teacher {
  id               String     @id @default(uuid())
  user_id          String     @unique
  currencyId       String
  hour_price       Float
  group_hour_price Float?     @default(0)
  active           Boolean    @default(false)
  roleId           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  avgRating        Float      @default(0)
  totalReviews     Int        @default(0)
  exams            exam[]
  homeworks        homework[]
  schedules        schedule[]
  currency         currency   @relation(fields: [currencyId], references: [id])
  role             role?      @relation(fields: [roleId], references: [id])
  user             user       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  conversations   Conversation[]
  weeklyReports   weekly_report[]
  teacherSubjects TeacherSubject[]
}

model weekly_report {
  id                 String   @id @default(uuid())
  teacherId          String
  weekStarting       DateTime
  weekEnding         DateTime
  totalClasses       Int      @default(0)
  studentsTaught     Int      @default(0)
  avgSessionDuration Float    @default(0)
  materialsUploaded  Int      @default(0)
  teachingSummary    String?
  studentProgress    String?
  challenges         String?
  overallRating      Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  teacher            teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([weekStarting])
}

model student {
  id                     String                    @id @default(uuid())
  user_id                String                    @unique
  birth_date             DateTime?
  qrToken                String?                   @unique
  qrActive               Boolean                   @default(true)
  type                   String?                   @default("online")
  active                 Boolean                   @default(false)
  planId                 String?
  country                String
  status                 String                    @default("pending")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  sessions               Float                     @default(0)
  sessions_attended      Float                     @default(0)
  sessions_remaining     Float                     @default(0)
  avgRating              Float                     @default(0)
  totalReviews           Int                       @default(0)
  parentNumber           String?
  rankId                 String?
  rank                   ranks?                    @relation(fields: [rankId], references: [id])
  exams                  exam[]
  homeworks              homework[]
  schedules              schedule[]
  plan                   plan?                     @relation(fields: [planId], references: [id])
  user                   user                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversations          Conversation[]
  userRankHistories      user_rank_history[]
  groupSchedules         GroupScheduleStudent[]
  coursePurchaseRequests course_purchase_request[]
  coursePurchases        CoursePurchase[]

  attendances Attendance[]
}

model schedule {
  id                  String                 @id @default(uuid())
  teacherId           String
  studentId           String?
  courseId            String
  status              String                 @default("scheduled")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  notes               String?
  pdfUrl              String?
  description         String?
  videoUrl            String?
  slidesUrl           String?
  link                String
  title               String
  platform            String?                @default("zoom")
  type                String                 @default("half")
  language            String                 @default("en")
  end_time            DateTime
  start_time          DateTime
  day_of_week         String?
  is_recurring        Boolean                @default(false)
  isGroup             Boolean                @default(false)
  maxStudents         String                 @default("1")
  parent_recurring_id String?
  rescheduledFromId   String?                @unique
  rescheduledToId     String?                @unique
  reviews             Review[]
  scheduleLogs        ScheduleLog?
  rescheduledTo       schedule?              @relation("RescheduleHistory", fields: [rescheduledToId], references: [id])
  rescheduledFrom     schedule?              @relation("RescheduleHistory")
  student             student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course              courses                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher             teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  requests            request[]
  lectures            lectures?              @relation(fields: [lecturesId], references: [id])
  lecturesId          String?
  order               Int?                   @default(0)
  groupStudents       GroupScheduleStudent[]
  subjectId           String?
  subject             subject?               @relation(fields: [subjectId], references: [id])

  @@index([teacherId])
  @@index([studentId])
  @@index([start_time])
  @@index([end_time])
  @@index([subjectId])
}

model GroupScheduleStudent {
  id         String   @id @default(uuid())
  scheduleId String
  studentId  String
  createdAt  DateTime @default(now())
  schedule   schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
  @@index([scheduleId])
  @@index([studentId])
}

model request {
  id            String    @id @default(uuid())
  sessionId     String?
  requesterId   String
  requesterRole String
  type          String
  priority      String    @default("medium") // low, medium, high
  title         String?
  status        String    @default("pending")
  reason        String?
  requestedData Json?
  adminId       String?
  adminNotes    String?
  attachments   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requester     user      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  schedule      schedule? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_request")
}

model audit_log {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String
  changes    Json?
  createdAt  DateTime @default(now())
}

model notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
}

model expenses {
  id           String        @id @default(uuid())
  title        String
  currencyId   String
  amount       Float
  payment_type String
  type         String
  status       String
  date         DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  currency     currency      @relation(fields: [currencyId], references: [id], onDelete: Cascade)
}

model homework {
  id             String   @id @default(uuid())
  title_ar       String   @default("")
  title_en       String?
  description_ar String   @default("")
  description_en String?
  status         String   @default("pending")
  dueDate        DateTime
  studentId      String
  teacherId      String
  subjectId      String?
  grade          Float?
  feedback       String?
  attachments    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher        teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject        subject? @relation(fields: [subjectId], references: [id])

  @@index([teacherId])
  @@index([studentId])
  @@index([subjectId])
}

model exam {
  id          String    @id @default(uuid())
  title_ar    String    @default("")
  title_en    String?
  subject     String?
  grade       Float     @default(0)
  studentId   String
  teacherId   String
  dueDate     DateTime
  totalMarks  Float     @default(100)
  duration    Float
  status      String    @default("pending")
  startedAt   DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  student     student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher     teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  questions exam_question[]
  answers   exam_answer[]
}

model exam_question {
  id        String   @id @default(uuid())
  examId    String
  text_ar   String   @default("")
  text_en   String?
  type      String   @default("mcq") // mcq | true_false
  points    Float    @default(1)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  options exam_option[]
  answers exam_answer[]

  @@index([examId])
}

model exam_option {
  id         String  @id @default(uuid())
  questionId String
  text_ar    String  @default("")
  text_en    String?
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question exam_question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  exam_answer[]

  @@index([questionId])
}

model exam_answer {
  id               String   @id @default(uuid())
  examId           String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exam           exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  question       exam_question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption exam_option?  @relation(fields: [selectedOptionId], references: [id])

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model subject {
  id        String   @id @default(uuid())
  name_ar   String   @default("")
  name_en   String?
  color     String   @default("#10b981")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherSubjects TeacherSubject[]
  homeworks       homework[]
  schedules       schedule[]
}

model TeacherSubject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model Subscription {
  id           String        @id @default(uuid())
  userId       String
  planId       String
  status       String        @default("active")
  amount       Float
  startDate    DateTime      @default(now())
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  currencyId   String
  currency     currency      @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  plan         plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Wallet {
  id           String        @id @default(uuid())
  type         String
  ownerId      String?
  balance      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  currencyId   String
  userId       String?
  transactions Transaction[]
  currency     currency      @relation(fields: [currencyId], references: [id])
  user         user?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id           String        @id @default(uuid())
  teacherId    String
  amount       Float
  status       String        @default("pending")
  currencyId   String?
  currency     currency?     @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  adminNotes   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  teacher      user          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
}

model Transaction {
  id                  String             @id @default(uuid())
  walletId            String
  type                String
  amount              Float
  status              String             @default("completed")
  reason              String?
  createdAt           DateTime           @default(now())
  expenseId           String?
  subscriptionId      String?
  withdrawalRequestId String?
  expense             expenses?          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  subscription        Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  wallet              Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
}

model ScheduleLog {
  id                 String    @id @default(uuid())
  scheduleId         String    @unique
  joinTime_student   DateTime?
  leaveTime_student  DateTime?
  joinTime_teacher   DateTime?
  leaveTime_teacher  DateTime?
  duration_student   Float?
  duration_teacher   Float?
  isTeacherLate      Boolean   @default(false)
  isTeacherCompleted Boolean   @default(false)
  isStudentAttended  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  schedule           schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  scheduleId String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  role       String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  reviewee   user     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   user     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  schedule   schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, reviewerId])
}

model Conversation {
  id        String    @id @default(uuid())
  teacherId String
  studentId String
  teacher   teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages  Message[]

  userTeacher   user?   @relation("TeacherConversations", fields: [teacherUserId], references: [id])
  userStudent   user?   @relation("StudentConversations", fields: [studentUserId], references: [id])
  teacherUserId String?
  studentUserId String?

  @@unique([teacherId, studentId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         user         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model ranks {
  id                String              @id @default(uuid())
  name_ar           String              @unique @default("")
  name_en           String?
  slug              String              @unique
  color             String?
  ageRange          Json
  stageName_ar      String?
  stageName_en      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  students          student[]
  courses           courses[]
  userRankHistories user_rank_history[]

  @@index([name_ar])
}

model category {
  id        String   @id @default(uuid())
  name_ar   String   @default("")
  name_en   String?
  color     String   @default("#6366f1")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses courses[]
}

model post {
  id           String    @id @default(uuid())
  type         String // "blog" | "news"
  title_ar     String
  title_en     String?
  slug         String    @unique
  excerpt_ar   String?
  excerpt_en   String?
  content_ar   String
  content_en   String?
  coverImage   String?
  authorId     String?
  author       user?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  published    Boolean   @default(false)
  publishedAt  DateTime?
  readingCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([published])
  @@index([slug])
}

model courses {
  id               String                    @id @default(uuid())
  title_ar         String                    @unique @default("")
  title_en         String?
  description_ar   String?
  description_en   String?
  keywords         String[]                  @default([])
  rankId           String
  categoryId       String?
  price            Float?
  image            String                    @default("default_course.jpg")
  rank             ranks                     @relation(fields: [rankId], references: [id], onDelete: Cascade)
  category         category?                 @relation(fields: [categoryId], references: [id])
  lectures         lectures[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  schedules        schedule[]
  purchaseRequests course_purchase_request[]
  purchases        CoursePurchase[]

  @@index([rankId])
  @@index([categoryId])
  @@index([title_ar])
}

model course_purchase_request {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
}

model CoursePurchase {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  purchasedAt DateTime @default(now())

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model lectures {
  id         String    @id @default(uuid())
  title_ar   String    @default("")
  title_en   String?
  content_ar String?
  content_en String?
  videoUrl   String?
  pdfUrl     String?
  slidesUrl  String?
  date       DateTime?
  order      Int
  courseId   String
  course     courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  duration   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userLectures user_lectures[]
  schedules    schedule[]

  @@unique([courseId, order])
  @@index([courseId])
}

model settings {
  id          String   @id @default(uuid())
  userPrefix  String   @default("mr_mahmoud")
  socialLinks Json
  contactInfo Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model user_lectures {
  id           String    @id @default(uuid())
  userId       String
  lectureId    String
  status       String    @default("completed")
  progress     Float     @default(0)
  lastPosition Float     @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture lectures @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId]) // مهم جدًا
  @@index([userId])
  @@index([lectureId])
}

model user_rank_history {
  id         String   @id @default(uuid())
  studentId  String
  rankId     String
  status     String   @default("locked") // locked, unlocked, completed
  achievedAt DateTime @default(now())

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rank    ranks   @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model policy {
  id             String   @id @default(uuid())
  title_ar       String   @default("")
  title_en       String?
  description_ar String   @default("")
  description_en String?
  icon           String? // e.g., "Shield", "Clock", "FileText", "AlertCircle"
  color          String? // e.g., "blue", "green", "purple", "orange"
  lastUpdated    DateTime @default(now())
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

model policy_notice {
  id         String   @id @default(uuid())
  title_ar   String   @default("تنبيه هام")
  title_en   String?  @default("Important Notice")
  content_ar String   @default("")
  content_en String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model support {
  id             String           @id @default(uuid())
  title_ar       String           @default("")
  title_en       String?
  url            String
  description_ar String           @default("")
  description_en String?
  category       support_category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  readingCount   Int              @default(0)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([active])
}

model support_category {
  id        String    @id @default(uuid())
  title_ar  String    @default("")
  title_en  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  supports  support[]

  @@index([active])
}

model Attendance {
  id             String   @id @default(uuid())
  studentId      String
  attendanceDate DateTime @db.Date // اليوم بس، للـ unique constraint
  checkedInAt    DateTime @default(now()) // الوقت الفعلي للـ check-in
  status         String   @default("present")
  checkedInById  String?  @map("checkedInBy")

  student     student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInBy user?   @relation("AttendanceCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([studentId, attendanceDate])
  @@index([studentId])
}
